{
  "name": "orca-slack",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "service:install": "node scripts/launch-agent.mjs install",
    "service:uninstall": "node scripts/launch-agent.mjs uninstall",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:orca": "npm run build && node scripts/orca-integration.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  },
  "dependencies": {
    "@slack/bolt": "^5.1.0"
  }
}
